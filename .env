# --- Passwörter ---
AUTH_DB_PASS=super_secret_shared_key
CUSTOMER_DB_PASS=cust_pass_change_me
PORTAL_USERS_DB_PASS=super_secret_shared_key
BUSINESS_DB1_PASS=biz_pass1_change_me
BUSINESS_DB2_PASS=biz_pass2_change_me
BUSINESS_DB3_PASS=biz_pass3_change_me
ADMIN_DB_PASS=admin_pass_change_me

# --- API Settings ---
API_JWT_SECRET=super_secret_shared_key
API_ACCESS_TOKEN_EXPIRE_MIN=60

# --- Connection URLs ---
AUTH_DATABASE_URL=postgresql://auth_user:${AUTH_DB_PASS}@auth_db:5432/auth_db
ADMIN_DATABASE_URL=postgresql://admin_user:${ADMIN_DB_PASS}@admin_db:5432/admin_db
CUSTOMER_DATABASE_URL=postgresql://customer_user:${CUSTOMER_DB_PASS}@customer_db:5432/customer_db
PORTAL_DATABASE_URL=postgresql://portal_user:${PORTAL_USERS_DB_PASS}@portal_users_db:5432/portal_users_db

BUSINESS_DB1_URL=postgresql://biz1_user:${BUSINESS_DB1_PASS}@business_db1:5432/business_db1
BUSINESS_DB2_URL=postgresql://biz2_user:${BUSINESS_DB2_PASS}@business_db2:5432/business_db2
BUSINESS_DB3_URL=postgresql://biz3_user:${BUSINESS_DB3_PASS}@business_db3:5432/business_db3

# Diese Liste sagt api/db.py, welche Business-DBs es überhaupt gibt
BUSINESS_DBS=business_db1,business_db2,business_db3

# --- PGAdmin Zugang ---
PGADMIN_EMAIL=pgadmin@beispiel.com
PGADMIN_PASS=pgadminpass

# --- SMTP / Mailserver ---
SMTP_MAILNAME=smtp.localdomain
# interne Docker-Netzwerke erlauben (typisch: 172.16.0.0/12)
SMTP_RELAY_NETWORKS=:172.16.0.0/12

# --- Gmail Relay SMTP ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=theboardary@gmail.com
SMTP_PASS=ainusjertzssklkg
